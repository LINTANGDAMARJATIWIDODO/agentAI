{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/agent", "destination": "/api/agent.js" },
    { "source": "/api/justdone-audit", "destination": "/api/justdone-audit.js" },
    { "source": "/api/audit", "destination": "/api/audit.js" },
    { "source": "/api/humanize", "destination": "/api/humanize.js" },
    { "source": "/api/red-team", "destination": "/api/red-team.js" },
    { "source": "/api/research", "destination": "/api/research.js" },
    { "source": "/api/download/(.*)", "destination": "/api/download.js?file=$1" },
    { "source": "/downloads/(.*)", "destination": "/api/download.js?file=$1" },
    { "source": "/api/report/(.*)", "destination": "/api/report.js?file=$1" },
    { "source": "/reports/(.*)", "destination": "/api/report.js?file=$1" },
    { "source": "/api/upload-pdf", "destination": "/api/status.js?action=upload-pdf" },
    { "source": "/api/detect", "destination": "/api/status.js?action=detect" },
    { "source": "/api/grammar", "destination": "/api/status.js?action=grammar" },
    { "source": "/api/paraphrase", "destination": "/api/status.js?action=paraphrase" },
    { "source": "/api/summarize", "destination": "/api/status.js?action=summarize" },
    { "source": "/api/run", "destination": "/api/status.js?action=run" },
    { "source": "/api/document/action", "destination": "/api/status.js" },
    { "source": "/api/document/citations", "destination": "/api/status.js?action=citations" },
    { "source": "/api/document/explain", "destination": "/api/status.js?action=explain" },
    { "source": "/api/document/study-plan", "destination": "/api/status.js?action=study-plan" },
    { "source": "/api/document/(.*)", "destination": "/api/status.js?action=$1" },
    { "source": "/api/ai/chat", "destination": "/api/gemini/chat.js" },
    { "source": "/api/ai/models", "destination": "/api/gemini/telemetry.js" },
    { "source": "/api/ai/usage", "destination": "/api/gemini/telemetry.js" },
    { "source": "/api/spbe/(.*)", "destination": "/api/spbe.js?action=$1" }
  ]
}
