{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/audit", "destination": "/api/audit" },
    { "source": "/api/humanize", "destination": "/api/humanize" },
    { "source": "/api/upload-pdf", "destination": "/api/status?action=upload-pdf" },
    { "source": "/api/detect", "destination": "/api/status?action=detect" },
    { "source": "/api/grammar", "destination": "/api/status?action=grammar" },
    { "source": "/api/paraphrase", "destination": "/api/status?action=paraphrase" },
    { "source": "/api/summarize", "destination": "/api/status?action=summarize" },
    { "source": "/api/run", "destination": "/api/status?action=run" },
    { "source": "/api/document/action", "destination": "/api/status" },
    { "source": "/api/document/citations", "destination": "/api/status?action=citations" },
    { "source": "/api/document/explain", "destination": "/api/status?action=explain" },
    { "source": "/api/document/study-plan", "destination": "/api/status?action=study-plan" },
    { "source": "/api/document/(.*)", "destination": "/api/status?action=$1" },
    { "source": "/api/ai/chat", "destination": "/api/gemini/chat" },
    { "source": "/api/ai/models", "destination": "/api/gemini/telemetry" },
    { "source": "/api/ai/usage", "destination": "/api/gemini/telemetry" },
    { "source": "/api/spbe/(.*)", "destination": "/api/spbe?action=$1" },
    { "source": "/api/report/(.*)", "destination": "/api/report?file=$1" }
  ]
}
