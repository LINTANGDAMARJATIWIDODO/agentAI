# NEXUS AI ENTERPRISE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure in Vercel Project Settings > Environment Variables

# 1. GOOGLE GEMINI API CONFIGURATION (REQUIRED FOR CHATBOT & SYNTHESIS)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. DYNAMIC BASE URL & CUSTOM GATEWAY (OPTIONAL)
# Defaults to https://generativelanguage.googleapis.com
# Example custom proxy / gateway: https://api.syncera.id
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# LLM_BASE_URL=https://api.syncera.id

# 3. MODEL SELECTION (OPTIONAL)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# 4. SERVER & RUNTIME (LOCAL DEV)
PORT=3000
NODE_ENV=production
